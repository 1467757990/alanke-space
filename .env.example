# ─────────────────────────────────────────────────────────────────────────────
# Alanke's Space — environment example
# ─────────────────────────────────────────────────────────────────────────────
# The site is fully static. No runtime secret is required for the default
# deployment: do NOT commit a real .env file.
#
# Cloudflare Pages settings (dashboard → Settings → Environment variables):
#   NODE_VERSION=26
#   PNPM_VERSION=11.28.2
# Optional, for large media/content builds:
#   NODE_OPTIONS=--max-old-space-size=4096
#
# Local sandboxes/CI that cannot write the user home may also need:
#   ASTRO_TELEMETRY_DISABLED=1

# [Optional] Font budget overrides (bytes)
# FONT_MAX_TOTAL_BYTES=4194304
# FONT_MAX_FAMILY_BYTES=2097152

# [Optional] Content separation (keep unset for this single-repository site).
# See docs/content-separation/ and docs/DEPLOYMENT.md.
# CONTENT_DIR="../shirone-content"
# CONTENT_REPO_URL="https://github.com/OWNER/shirone-content.git"
# CONTENT_REPO_REF="main"
# CONTENT_SYNC_PULL="true"
# SHIRONE_CONTENT_SYNC="1"

# [Optional] Bilibili anime sync (disabled in this site's config).
# BILI_SESSDATA="your_bilibili_sessdata_here"
