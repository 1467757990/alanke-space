---
/** 独立音乐空间：复用共享 music runtime，与全站悬浮播放器保持同步。 */
import MusicPage from "@components/organisms/music/MusicPage.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { withOptimizedMusicCovers } from "@utils/music/cover-assets";
import { getMusicLabels } from "@utils/music/labels";
import { musicConfig, resolveMusicOptions } from "@/config/musicConfig";
import { musicProfile } from "@/data/music";

if (!musicConfig.enable) {
	return Astro.redirect("/404/");
}

const baseOptions = resolveMusicOptions(musicConfig);
if (!baseOptions) {
	return Astro.redirect("/404/");
}
const options = await withOptimizedMusicCovers(baseOptions);
const labels = getMusicLabels();
---

<MainGridLayout
	title={musicProfile.title}
	description={musicProfile.description}
	page="music"
>
	<MusicPage
		{options}
		{labels}
		subtitle={musicProfile.description}
		note={musicProfile.note}
		client:load
	/>
</MainGridLayout>
